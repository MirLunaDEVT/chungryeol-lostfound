# [충렬고등학교 분실물 시스템 환경변수 설정 가이드]
NEXT_PUBLIC_SCHOOL_NAME="충렬고등학교"
NEXT_PUBLIC_SITE_NAME="충렬고 분실물 찾기"
GOOGLE_ALLOWED_DOMAINS="pscr.hs.kr"
TEACHER_DOMAIN="pscr.hs.kr"
ADMIN_EMAIL="teacher@pscr.hs.kr"
DEFAULT_HANDOVER_PLACE="본관 1층 학생안전복지부 분실물 보관함"
STUDENT_NO_REGEX="^([0-9]{4,6}|T[0-9]{4})$"

# [데이터베이스]
# 1. 로컬 개발 테스트:
DATABASE_URL="file:./dev.db"
# 2. Vercel 상시 배포 시 (Neon PostgreSQL 서울 리전 무료 DB URL 입력):
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.ap-northeast-2.aws.neon.tech/neondb?sslmode=require"

# [인증 - NextAuth]
NEXTAUTH_URL="https://your-project.vercel.app"
NEXTAUTH_SECRET="schoolfound-super-secret-key-32chars-min-generate-random"

# [Google OAuth 2.0 Credentials (선택사항)]
GOOGLE_CLIENT_ID=""
